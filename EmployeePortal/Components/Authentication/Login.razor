@page "/admin-login"
@using Application.Dto.AuthDto
@layout EmptyLayout
@inject NavigationManager Navigation
@inject IAuthService AuthService
@inject HttpClient Http;
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Admin-Login</PageTitle>
<style>
    .login-page {
        height: 100vh;
        background: #f5f5f5;
        position: relative;
        overflow: hidden;
    }

    .top-section {
        height: 40%;
        clip-path: ellipse(100% 75% at 50% 0%);
        padding-top: 100px;
        position: relative;
    }

        .top-section::after {
            content: "";
            position: absolute;
            inset: 0;
            background: rgba(0, 0, 0, 0.1);
        }

        .top-section > div {
            position: relative;
            z-index: 1;
        }

    .login-card {
        position: absolute;
        top: 25%;
        left: 50%;
        transform: translateX(-50%);
        width: 400px;
        background: white;
        padding: 20px;
        border-radius: 10px;
    }
    .alert-container {
    min-height: 50px; 
}

