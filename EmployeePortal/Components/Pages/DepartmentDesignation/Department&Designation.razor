@page "/departments-designations"

<div class="top-header">
    <div class="top-title">
        <h3>Department & Designation </h3>
    </div>

    <div class="top-actions">
        <div class="input-group" style="width:250px;">

            <input type="text"
                   class="form-control"
                   placeholder="Search employees..."/>

            <span class="input-group-text">
                <i class="bi bi-search"></i>
            </span>

        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card shadow-sm border-0" style="height:150px;">
            <div class="card-body d-flex align-items-center gap-3">
                    <i class="fa fa-users fa-2x text-secondary"></i>
                    <div>
                        <h2 class="mb-0">12</h2>
                        <small>Total Departments</small><br />
                        <span class="text-success">Active 10</span>,
                        <span class="text-danger">Inactive 2</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
        <div class="card shadow-sm border-0" style="height:150px;">
            <div class="card-body d-flex align-items-center gap-3">
                    <i class="fa fa-sitemap fa-2x text-secondary"></i>
                    <div>
                        <h2 class="mb-0">45</h2>
                        <small>Unique Designations</small><br />
                        <span class="text-success">Active 40</span>,
                        <span class="text-danger">Inactive 5</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">

        <!-- DEPARTMENT TABLE -->
        <div class="col-md-7">
            <div class="card shadow-sm">
                <div class="card-body p-0">

                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Dept. Name</th>
                                <th>Manager</th>
                                <th>Status</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            <tr>
                                <td>IT</td>
                                <td>John Doe</td>
                                <td>
                                    <span class="badge bg-success">Active</span>
                                </td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-outline-primary me-1">
                                        <i class="fa fa-edit"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger">
                                        <i class="fa fa-trash"></i>
                                    </button>
                                </td>
                            </tr>

                            <tr>
                                <td>Finance</td>
                                <td>Jane Smith</td>
                                <td>
                                    <span class="badge bg-warning text-dark">On Leave</span>
                                </td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-outline-primary me-1">
                                        <i class="fa fa-edit"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger">
                                        <i class="fa fa-trash"></i>
                                    </button>
                                </td>
                            </tr>

                            <tr>
                                <td>HR</td>
                                <td>Peter Jones</td>
                                <td>
                                    <span class="badge bg-success">Active</span>
                                </td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-outline-primary me-1">
                                        <i class="fa fa-edit"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger">
                                        <i class="fa fa-trash"></i>
                                    </button>
                                </td>
                            </tr>

                        </tbody>
                    </table>

                </div>
            </div>
        </div>

        <!-- DESIGNATION TABLE -->
        <div class="col-md-5">
            <div class="card shadow-sm">
                <div class="card-body p-2">

                    <!-- SEARCH -->
                    <div class="input-group mb-2">
                        <input class="form-control" placeholder="Search designation..." />
                        <span class="input-group-text">
                            <i class="fa fa-search"></i>
                        </span>
                    </div>

                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Designation</th>
                                <th>Dept.</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>
                            <tr>
                                <td>Lead Developer</td>
                                <td>IT</td>
                                <td><span class="badge bg-success">Active</span></td>
                            </tr>

                            <tr>
                                <td>HR Specialist</td>
                                <td>HR</td>
                                <td><span class="badge bg-success">Active</span></td>
                            </tr>

                            <tr>
                                <td>Payroll Officer</td>
                                <td>Finance</td>
                                <td><span class="badge bg-danger">Inactive</span></td>
                            </tr>

                        </tbody>
                    </table>

                </div>
            </div>
        </div>
</div>