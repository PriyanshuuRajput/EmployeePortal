@page "/departments-designations"
@inject SpinnerService spinnerService
@inject IDepartmentService departmentService
@inject IDesignationService designationService
@rendermode InteractiveServer
<style>

    .action-column {
        position: sticky;
        right: 0;
        background: white;
        min-width: 120px;
        text-align: center;
        box-shadow: -2px 0 4px rgba(0,0,0,0.05);
        z-index: 10;
    }

    .action-buttons {
        display: flex;
        justify-content: flex-end;
    }

    .btn-icon {
        width: 32px;
        height: 32px;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .edit-btn {
        background: #eef4ff;
        color: #f59e0b;
    }

        .edit-btn:hover {
            background: #dbe7ff;
        }

        .create-btn{
            background: #eef4ff;
            color:#43536a;
        }
        .create-btn:hover {
            background: #dbe7ff;
        }
    .delete-btn {
        background: #fff1f2;
        color: #ef4444;
    }

        .delete-btn:hover {
            background: #ffe4e6;
        }
</style>
<div class="top-header">
    <div class="top-title">
        <h3>Department & Designation </h3>
    </div>

    <div class="top-actions">
        <select class="form-select filter-select" @bind="selectedDepartmentId" @bind:after="ApplyFilter">
            <option value="" disabled selected>Department</option>
            @if (departments != null)
            {
                @foreach (var dept in departments)
                {
                    <option value="@dept.Id">@dept.Name</option>
                }
            }
        </select>
        <select class="form-select filter-select" @bind="selectedDesignationId" @bind:after="ApplyFilter">
            <option value="" disabled selected>Designation</option>
            @if (designations != null)
            {
                @foreach (var des in designations)
                {
                    <option value="@des.Id">@des.Name</option>
                }
            }
        </select>
        <button class="btn btn-create " style="color:white ;background:#43536a; display:flex" @onclick="Reset">
            <i class="bi bi-arrow-clockwise me-2"></i> Refresh
        </button>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-6 mb-2">
        <div class="card shadow-sm border-0" style="height:150px;">
            <div class="card-body d-flex align-items-center gap-3">
                    <i class="fa fa-users fa-2x text-secondary"></i>
                    <div>
                        <h2 class="mb-0">4</h2>
                        <small>Total Departments</small><br />
                        <span class="text-success">Active 4</span>,
                        <span class="text-danger">Inactive 0</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-2">
        <div class="card shadow-sm border-0" style="height:150px;">
            <div class="card-body d-flex align-items-center gap-3">
                    <i class="fa fa-sitemap fa-2x text-secondary"></i>
                    <div>
                        <h2 class="mb-0">5</h2>
                        <small>Unique Designations</small><br />
                        <span class="text-success">Active 5</span>,
                        <span class="text-danger">Inactive 0</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

<div class="row">

        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body p-0">

                <table class="table responsive-table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                            <th @onclick='() => SortDepartment("department")' style="cursor:pointer">
                                Department Name
                                <i class="bi @(deptSortColumn == "department" ? (deptSortDirection == "asc" ? "bi-arrow-up" : "bi-arrow-down") : "bi-arrow-down-up") ms-2"></i>
                            </th>
                                <th>Status</th>
                            <th class="text-end action-column">Actions</th>
                            </tr>
                        </thead>
                    <tbody>
                        @if (departments != null)
                        {
                            @foreach (var dept in departments)
                            {
                                <tr>
                                    <td>@dept.Name</td>

                                    <td>
                                        <span class="badge @(dept.IsActive ? "bg-success" : "bg-secondary")">
                                            @(dept.IsActive ? "Active" : "Inactive")
                                        </span>
                                    </td>

                                    <td class="text-end action-column">
                                        <div class="d-flex justify-content-end align-items-center gap-2">
                                            @* <span class="badge @(emp.IsActive ? "active-badge" : "inactive-badge")">@(emp.IsActive ? "Active" : "Inactive")</span> *@
                                            <div class="action-buttons">

                                                <button class="btn btn-icon create-btn"
                                                        title="Create"
                                                        style="border-radius: 6px 0px 0px 6px;" disabled>
                                                    <i class="bi bi-plus"></i>
                                                </button>

                                                <button class="btn btn-icon edit-btn"
                                                        title="Edit"
                                                        style="border-radius: 0px;" disabled>
                                                    <i class="bi bi-pencil"></i>
                                                </button>

                                                <button class="btn btn-icon delete-btn"
                                                        title="Delete"
                                                        style="border-radius: 0px 6px 6px 0px;" disabled>
                                                    <i class="bi bi-trash"></i>
                                                </button>

                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    
                    </tbody>
                    <tfoot class="table-light table-footer">
                        <tr>
                            <td colspan="11">
                                <div class="d-flex justify-content-between table-pagination">
                                    <div>
                                        <span class="text-muted">
                                            Showing @start–@end of @totalCount departments
                                            (Page @pageNumber of @totalCount)
                                        </span>
                                    </div>
                                    <div>
                                        <span class="page-nav"
                                              @onclick="PreviousPage"
                                              style="@(HasPrevious ? "" : "pointer-events:none;opacity:0.4")">
                                            <i class="bi bi-chevron-left"></i>
                                        </span>

                                        @for (int i = 1; i <= Math.Ceiling((double)totalCount / pageSize); i++)
                                        {
                                            var index = i;
                                            <span class="page-number @(pageNumber == index ? "active-page" : "")"
                                                  @onclick="() => GoToPage(index)">
                                                @index
                                            </span>
                                        }

                                        <span class="page-nav"
                                              @onclick="NextPage"
                                              style="@(HasNext ? "" : "pointer-events:none;opacity:0.4")">
                                            <i class="bi bi-chevron-right"></i>
                                        </span>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    </tfoot>
                    </table>

                </div>
            </div>
        </div>

        <!-- DESIGNATION TABLE -->
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body p-0">

                <table class="table responsive-table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                            <th  @onclick='() => SortDesignation("designation")' style="cursor:pointer">
                                Designation Name
                                <i class="bi @(desSortColumn == "designation" ? (desSortDirection == "asc" ? "bi-arrow-up" : "bi-arrow-down") : "bi-arrow-down-up") ms-2"></i>
                            </th>
                                <th>Status</th>
                            <th class="text-end action-column">Actions</th>
                            </tr>
                        </thead>
                    <tbody>
                        @if (designations != null)
                        {
                            foreach (var des in designations)
                            {
                                <tr>
                                    <td>@des.Name</td>

                                    <td>
                                        <span class="badge @(des.IsActive ? "bg-success" : "bg-secondary")">
                                            @(des.IsActive ? "Active" : "Inactive")
                                        </span>
                                    </td>

                                    <td class="text-end action-column">
                                        <div class="d-flex justify-content-end align-items-center gap-2">
                                            @* <span class="badge @(emp.IsActive ? "active-badge" : "inactive-badge")">@(emp.IsActive ? "Active" : "Inactive")</span> *@
                                            <div class="action-buttons">

                                                <button class="btn btn-icon edit-btn"
                                                        title="Edit"
                                                        style="border-radius: 6px 0px 0px 6px;" disabled>
                                                    <i class="bi bi-pencil"></i>
                                                </button>

                                                <button class="btn btn-icon delete-btn"
                                                        title="Delete"
                                                        style="border-radius: 0px 6px 6px 0px;" disabled>
                                                    <i class="bi bi-trash"></i>
                                                </button>

                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    
                    </tbody>
                    <tfoot class="table-light table-footer">
                        <tr>
                            <td colspan="11">
                                <div class="d-flex justify-content-between table-pagination">
                                    <div>
                                        <span class="text-muted">
                                            Showing @start–@end of @totalCount designations
                                            (Page @pageNumber of @totalCount)
                                        </span>
                                    </div>
                                    <div>
                                        <span class="page-nav"
                                              @onclick="PreviousPage"
                                              style="@(HasPrevious ? "" : "pointer-events:none;opacity:0.4")">
                                            <i class="bi bi-chevron-left"></i>
                                        </span>

                                        @for (int i = 1; i <= Math.Ceiling((double)totalCount / pageSize); i++)
                                        {
                                            var index = i;
                                            <span class="page-number @(pageNumber == index ? "active-page" : "")"
                                                  @onclick="() => GoToPage(index)">
                                                @index
                                            </span>
                                        }

                                        <span class="page-nav"
                                              @onclick="NextPage"
                                              style="@(HasNext ? "" : "pointer-events:none;opacity:0.4")">
                                            <i class="bi bi-chevron-right"></i>
                                        </span>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    </tfoot>
                    </table>

                </div>
            </div>
        </div>
</div>

@code{
    private List<DepartmentDto>? departments;
    private List<DesignationDto>? designations;
    private int? selectedDepartmentId;
    private int? selectedDesignationId;

    private int pageNumber = 1;
    private int pageSize = 10;
    private int totalCount;
    private int start;
    private int end;

    private string deptSortColumn = "";
    private string deptSortDirection = "asc";

    private string desSortColumn = "";
    private string desSortDirection = "asc";
    private string search = "";

    private bool HasPrevious => pageNumber > 1;
    private bool HasNext => pageNumber < Math.Ceiling((double)totalCount / pageSize);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            spinnerService.Show();
            await Task.Delay(200);
            await Load();

        }
        catch (Exception e)
        {
            Console.WriteLine(e.Message);
        }
        finally
        {
            spinnerService.Hide();
        }
    }

    private async Task Load()
    {
        spinnerService.Show();
        try
        {
            var deptResult = await departmentService.GetAllAsync(pageNumber, pageSize, search, selectedDepartmentId,deptSortColumn, deptSortDirection);
            var desResult = await designationService.GetAllDesignationsAsync(pageNumber, pageSize, search, selectedDesignationId, desSortColumn, desSortDirection);

            departments = deptResult.Items;
            designations = desResult.Items;
            totalCount = deptResult.TotalCount;
            start = (pageNumber - 1) * pageSize + 1;
            end = Math.Min(pageNumber * pageSize, totalCount);
        }
        finally
        {
            spinnerService.Hide();
        }
    }
    private async Task SortDepartment(string column)
    {
        if (deptSortColumn == column)
            deptSortDirection = deptSortDirection == "asc" ? "desc" : "asc";
        else
        {
            deptSortColumn = column;
            deptSortDirection = "asc";
        }
        await Load();
    }
    private async Task SortDesignation(string column)
    {
        if (desSortColumn == column)
            desSortDirection = desSortDirection == "asc" ? "desc" : "asc";
        else
        {
            desSortColumn = column;
            desSortDirection = "asc";
        }

        await Load();
    }
    private async Task ApplyFilter()
    {
        pageNumber = 1;
        await Load();
    }
    private async Task Reset()
    {
        selectedDepartmentId = null;
        selectedDesignationId = null;
        pageNumber = 1;
        deptSortColumn = "";
        deptSortDirection = "desc";
        desSortColumn = "";
        desSortDirection = "desc";
        await Load();

    }
    private async Task NextPage()
    {
        if (HasNext)
        {
            pageNumber++;
            await Load();
        }
    }

    private async Task PreviousPage()
    {
        if (HasPrevious)
        {
            pageNumber--;
            await Load();
        }
    }

    private async Task GoToPage(int page)
    {
        pageNumber = page;
        await Load();
    }
}