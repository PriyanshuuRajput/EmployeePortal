@inject IJSRuntime JS
@inject NavigationManager Navigation
@rendermode InteractiveServer

<div class="d-flex flex-column h-100">
<div class="navbar navbar-dark px-0 w-100"
     style="border-radius:0 0 6px 6px; background:#ffffff; border:1px solid #1e293b; overflow:hidden;">
    <div class="d-flex align-items-center gap-2 px-3">
        <img src="/default/logo.png" alt="logo" style="height: 40px;width: 40px;object-fit: cover;">

        <a class="navbar-brand fw-bold m-0" href="#">
            StaffSphere
        </a>

    </div>
</div>

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">

    <nav class="nav flex-column">

        <div class="menu-title px-2 mt-2">MAIN</div>

        <div class="nav-item px-0 mb-2">
            <NavLink class="nav-link" href="dashboard" Match="NavLinkMatch.All">
                <span class="bi bi-dashboard-nav-menu"></span>
                <span>Dashboard</span>
            </NavLink>
        </div>

        <div class="nav-item px-0 mb-2">
            <NavLink class="nav-link" href="employees">
                <span class="bi bi-employees-nav-menu"></span>
                <span>Employees</span>
            </NavLink>
        </div>

        <div class="nav-item px-0 mb-2">
                <NavLink class="nav-link" href="departments-designations">
                <span class="bi bi-departments-nav-menu"></span>
                <span>Department & Designation</span>
            </NavLink>
        </div>


        <div class="menu-title px-2 mt-2">MANAGEMENT</div>
        <hr />
        <div class="nav-item px-0 mb-2">
            <NavLink class="nav-link" href="attendance">
                <span></span>
            </NavLink>
        </div>


        <div class="menu-title px-2 mt-2">SYSTEM</div>
        <hr />
        <div class="nav-item px-0 mb-2">
            <NavLink class="nav-link" href="settings">
                <span></span>
            </NavLink>
        </div>

    </nav>
</div>
<div class="mt-auto p-2" style="margin-left:auto;">
        <button class="btn w-100 " style="color:#f59e0b"
                @onclick="Logout">
        <i class="bi bi-box-arrow-right me-2"></i>
        Logout
    </button>
</div>
</div>
@code {
    private async Task Logout()
    {
        try
        {
            await JS.InvokeVoidAsync("User", "/logout");
            Navigation.NavigateTo("/admin-login", true);
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }
}